# Copy this file to .env and fill in real values.

# Postgres connection string.
# Local dev (matches docker-compose.yml): postgresql://postgres:postgres@localhost:5433/finances_db
# Production: Supabase Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/finances_db

# JWT signing secret. MUST match the frontend's JWT_SECRET (used to verify
# tokens in Next.js middleware) or route protection on the frontend will break.
SECRET_KEY=change-me-to-a-long-random-string

# JWT signing algorithm.
ALGORITHM=HS256

# Access token time-to-live, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# "development" (default) or "production". Controls whether the auth cookie
# is marked Secure (required for it to be sent over HTTPS-only in prod).
ENVIRONMENT=development

# Domain attribute for the httpOnly auth cookie. Leave unset for local dev
# (frontend and backend both on "localhost", the cookie just works). In
# production this MUST be the shared parent domain of frontend and backend,
# e.g. ".balancedcent.com", so the cookie reaches both the Next.js middleware
# (on the frontend's domain) and the API (on its own subdomain).
COOKIE_DOMAIN=
